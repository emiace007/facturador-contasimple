# URL del Web App de Apps Script (termina en /exec) — ver apps-script/SETUP.md
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXX/exec

# Misma clave configurada en Propiedades del Script como API_KEY
VITE_APPS_SCRIPT_API_KEY=

# Opcional: PIN compartido del equipo. Si se deja vacío, la app no pide PIN.
# Es una traba liviana para uso interno, no un sistema de usuarios real.
VITE_APP_PIN=
