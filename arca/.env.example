# Ambiente: "homologacion" (pruebas, sin validez fiscal) o "produccion"
AFIP_ENV=homologacion

# Certificado y clave privada del ESTUDIO (uno solo, no uno por cliente), en formato PEM.
# Pegá el contenido completo (con -----BEGIN...----- y -----END...-----), respetando
# los saltos de línea. Si tu hosting no admite variables multilínea, guardalas en
# base64 (una sola línea) y descomentalas en config.js el decodificador ya está listo
# para aceptar ambos formatos.
AFIP_CERT_PEM=
AFIP_KEY_PEM=

# Clave simple para proteger este backend: el sistema principal (Apps Script) la manda
# en el header "x-api-key". Elegí cualquier texto largo al azar.
BACKEND_API_KEY=

# Puerto local (Render/Railway lo pisan automáticamente con su propia variable PORT)
PORT=3000

# Conexión a la base (Supabase), con el rol app_user (NO el usuario postgres). Solo en variables de entorno, nunca en el repo.
DATABASE_URL=
